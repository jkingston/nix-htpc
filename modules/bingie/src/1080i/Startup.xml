<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">10</defaultcontrol>
    <include>DefaultSkinSettings</include>
    <onload>SetProperty(Random,$INFO[System.Time(ss)],Home)</onload>
    <onload>ClearProperty(StartupMask,Home)</onload>
    <onload>ReplaceWindow($VAR[StartUpWindow])</onload>
	
	<!-- Start TMDbH service -->
    <onload>Skin.SetBool(TMDbBingieHelper.Service)</onload>
	<onload>Skin.SetBool(TMDbBingieHelper.DirectCallAuto)</onload>
	<onload>Skin.SetString(TMDbBingieHelper.MonitorContainer,17195)</onload>
</window>
