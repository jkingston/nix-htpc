<?xml version="1.0" encoding="utf-8"?>
<!--
  nix-htpc BINGIE playback presentation.

  The service publishes a complete inactive slot and flips htpc.seek.viewslot
  only after every field is ready. The two groups below are deliberately
  identical apart from their property namespace and slot condition.
-->
<includes>
	<include name="HTPCPlaybackPresentation">
		<!-- Compatibility wrapper for the currently live inherited OSD. -->
		<include content="HTPCPlaybackPresentationLayout" />
	</include>

	<include name="HTPCPlaybackPresentationLayout">
		<param name="visible" default="Player.HasVideo" />
		<param name="rail_left" default="384" />
		<param name="rail_top" default="964" />
