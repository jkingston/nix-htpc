		<control type="group">
			<description>HTPC playback presentation slot a</description>
			<visible>!String.IsEmpty(Window(Home).Property(htpc.service.ready)) + !String.IsEmpty(Window(Home).Property(htpc.seek.viewactive)) + String.IsEqual(Window(Home).Property(htpc.seek.viewslot),a) + $PARAM[visible]</visible>
