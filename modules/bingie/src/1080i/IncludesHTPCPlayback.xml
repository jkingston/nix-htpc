<?xml version="1.0" encoding="utf-8"?>
<!--
  nix-htpc BINGIE playback presentation.

  The service publishes a complete inactive slot and flips htpc.seek.viewslot
  only after every field is ready. One parameterized template renders the
  selected A or B slot without duplicating presentation controls.
-->
<includes>
	<include name="HTPCPlaybackPresentationSlot">
		<param name="slot" />
		<param name="visible" default="Player.HasVideo" />
		<param name="rail_left" default="384" />
		<param name="rail_top" default="964" />
		<param name="rail_width" default="1152" />
		<param name="rail_height" default="7" />
		<param name="marker_top" default="955" />
		<param name="marker_height" default="24" />
		<param name="target_marker_top" default="957.5" />
		<param name="target_marker_height" default="20" />
		<param name="preview_left" default="194" />
		<param name="preview_top" default="650" />
		<param name="preview_width" default="380" />
		<param name="preview_height" default="320" />
		<param name="target_fill_color" default="$INFO[Skin.String(BingieOSDProgressBarColor)]" />
		<param name="preview_loading_label" default="$LOCALIZE[31582]" />
		<param name="preview_unavailable_label" default="$LOCALIZE[31583]" />
		<param name="preview_background_load" default="true" />
		<param name="preview_visible_condition" default="true" />
		<param name="ready_condition" default="!String.IsEmpty(Window(Home).Property(htpc.service.ready))" />
		<param name="property_window" default="Home" />
		<param name="property_prefix" default="htpc.seek" />
		<definition>
		<control type="group">
			<description>HTPC playback presentation slot $PARAM[slot]</description>
			<visible>$PARAM[ready_condition] + !String.IsEmpty(Window($PARAM[property_window]).Property($PARAM[property_prefix].viewactive)) + String.IsEqual(Window($PARAM[property_window]).Property($PARAM[property_prefix].viewslot),$PARAM[slot]) + $PARAM[visible]</visible>
			<control type="ranges">
				<description>HTPC target progress fill</description>
				<posx>$PARAM[rail_left]</posx>
				<posy>$PARAM[rail_top]</posy>
				<width>$PARAM[rail_width]</width>
				<height>$PARAM[rail_height]</height>
				<texturebg colordiffuse="00ffffff">diffuse/panel2.png</texturebg>
				<lefttexture/>
				<midtexture colordiffuse="$PARAM[target_fill_color]">diffuse/panel2.png</midtexture>
				<righttexture/>
				<info>Window($PARAM[property_window]).Property($PARAM[property_prefix].$PARAM[slot].targetfill)</info>
				<visible>!String.IsEmpty(Window($PARAM[property_window]).Property($PARAM[property_prefix].$PARAM[slot].targetvalid))</visible>
			</control>
			<control type="ranges">
				<description>HTPC cut markers</description>
				<posx>$PARAM[rail_left]</posx>
				<posy>$PARAM[marker_top]</posy>
				<width>$PARAM[rail_width]</width>
				<height>$PARAM[marker_height]</height>
				<texturebg colordiffuse="00ffffff">diffuse/panel2.png</texturebg>
				<midtexture colordiffuse="$INFO[Skin.String(BingieOSDTextColor)]">diffuse/osd_range.png</midtexture>
				<info>Player.Cutlist</info>
				<visible>Skin.HasSetting(ChapterMarks)</visible>
			</control>
			<control type="ranges">
				<description>HTPC chapter markers</description>
				<posx>$PARAM[rail_left]</posx>
				<posy>$PARAM[marker_top]</posy>
				<width>$PARAM[rail_width]</width>
				<height>$PARAM[marker_height]</height>
				<texturebg colordiffuse="00ffffff">diffuse/panel2.png</texturebg>
				<righttexture colordiffuse="$INFO[Skin.String(BingieOSDTextColor)]">diffuse/osd_range.png</righttexture>
				<info>Player.Chapters</info>
				<visible>Integer.IsGreater(Player.ChapterCount,1)</visible>
			</control>
			<control type="ranges">
				<description>HTPC target position marker</description>
				<posx>$PARAM[rail_left]</posx>
				<posy>$PARAM[target_marker_top]</posy>
				<width>$PARAM[rail_width]</width>
				<height>$PARAM[target_marker_height]</height>
				<texturebg colordiffuse="00ffffff">special://skin/resources/htpc/osd/timeline-marker.png</texturebg>
				<lefttexture colordiffuse="$INFO[Skin.String(OSDBingieButtonsFocusColor)]">special://skin/resources/htpc/osd/timeline-marker.png</lefttexture>
				<midtexture/>
				<righttexture/>
				<info>Window($PARAM[property_window]).Property($PARAM[property_prefix].$PARAM[slot].targetmarker)</info>
				<visible>!String.IsEmpty(Window($PARAM[property_window]).Property($PARAM[property_prefix].$PARAM[slot].targetvalid))</visible>
			</control>
			<control type="group">
				<description>HTPC cursor-following preview</description>
				<posx>$PARAM[preview_left]</posx>
				<posy>$PARAM[preview_top]</posy>
				<width>$PARAM[preview_width]</width>
				<height>$PARAM[preview_height]</height>
