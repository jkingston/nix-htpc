<?xml version="1.0" encoding="utf-8"?>
<!-- Stable Kodi routes; the playlist adapter discovers Jellyfin at runtime. -->
<shortcuts>
    <shortcut>
        <label>Continue Watching</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,plugin://script.bingie.widgets/?action=inprogressnextepisode&amp;mediatype=media&amp;limit=25,return)</action>
    </shortcut>
    <shortcut>
        <label>Next Episodes</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,plugin://script.bingie.widgets/?action=nextinprogress&amp;mediatype=episodes&amp;limit=25,return)</action>
    </shortcut>
    <shortcut>
        <label>Playlists</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,plugin://script.bingie.widgets/?action=serverplaylists&amp;mediatype=media&amp;limit=25,return)</action>
    </shortcut>
    <shortcut>
        <label>Recently Added Movies</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,library://video/movies/recentlyaddedmovies.xml,return)</action>
    </shortcut>
    <shortcut>
        <label>Recently Added TV Shows</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,special://skin/extras/widgetplaylists/recentlyaddedtvshows.xsp,return)</action>
    </shortcut>
    <shortcut>
        <label>Collections</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,library://video/movies/sets.xml,return)</action>
    </shortcut>
</shortcuts>
