    </shortcut>
    <shortcut>
        <label>All Movies</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,library://video/movies/titles.xml,return)</action>
        <property name="widgetstyle">poster</property>
    </shortcut>
