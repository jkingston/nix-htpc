        <label>Continue Watching</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,special://skin/extras/widgetplaylists/inprogressmovies.xsp,return)</action>
        <property name="widgetstyle">landscape</property>
    </shortcut>
    <shortcut>
