<?xml version="1.0" encoding="utf-8"?>
<shortcuts>
    <shortcut>
        <label>Next Episodes</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,plugin://script.bingie.widgets/?action=nextinprogress&amp;mediatype=episodes&amp;limit=25,return)</action>
        <property name="widgetstyle">landscape</property>
    </shortcut>
    <shortcut>
        <label>Recently Added TV Shows</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,library://video/tvshows/recentlyaddedepisodes.xml,return)</action>
        <property name="widgetstyle">poster</property>
    </shortcut>
    <shortcut>
        <label>All TV Shows</label>
        <label2 />
        <icon />
        <thumb />
        <action>ActivateWindow(Videos,library://video/tvshows/titles.xml,return)</action>
        <property name="widgetstyle">poster</property>
    </shortcut>
</shortcuts>
