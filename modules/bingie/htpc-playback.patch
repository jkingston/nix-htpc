--- a/1080i/Home.xml
+++ b/1080i/Home.xml
@@ -50,6 +50,21 @@
 	
 		<!-- Home Screen -->
         <include>HomeBingie</include>
+		<!-- Hide the home carousel while a video selected in the information
+		     dialog is being resolved. The play controls set this property. -->
+		<control type="group">
+			<visible>!String.IsEmpty(Window(Home).Property(BingiePlaybackStarting))</visible>
